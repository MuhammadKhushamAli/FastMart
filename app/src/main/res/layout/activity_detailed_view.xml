<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="20dp"
    tools:context=".DetailedView">
    <ScrollView
        android:id="@+id/details"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/buy_button"
        android:layout_alignParentTop="true"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                >
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/back_arrow"
                    android:id="@+id/back_arrow"
                    android:contentDescription="@string/back_arrow_desc"
                    />
                <ImageView
                    android:id="@+id/detailed_item_image"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:contentDescription="@string/dod_img_description"
                    android:layout_marginBottom="40dp"
                    android:layout_gravity="center"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentStart="true"
                    android:layout_below="@id/back_arrow"
                    />
            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="5dp"
                >
                <TextView
                    android:id="@+id/detailed_item_discounted_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:fontFamily="sans-serif-black"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginEnd="5dp"
                    />
                <TextView
                    android:id="@+id/detailed_item_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:fontFamily="sans-serif-black"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    />
            </LinearLayout>
            <TextView
                android:id="@+id/detailed_item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:textSize="25sp"
                android:layout_marginBottom="5dp"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="5dp"
                >
                <TextView
                    android:id="@+id/detailed_item_model"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-light"
                    android:textStyle="normal"
                    android:textSize="15sp"
                    android:textAlignment="viewStart"
                    />
                <TextView
                    android:id="@+id/detailed_item_color"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-light"
                    android:textStyle="normal"
                    android:textSize="15sp"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="5dp"
                    />
            </LinearLayout>
            <TextView
                android:id="@+id/detailed_item_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="normal"
                android:textSize="11sp"
                android:textAlignment="viewStart"
                android:fontFamily="sans-serif-light"
                />
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buy_button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:cornerRadius="10dp"
        android:backgroundTint="?button_bg_color"
        android:text="@string/buy_button"
        android:layout_alignParentBottom="true"
        />
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/confirmation_popup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />
</RelativeLayout>